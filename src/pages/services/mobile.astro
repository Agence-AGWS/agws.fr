---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';
import { Contact } from '../../components/Contact';
import Footer from '../../components/Footer.astro';
import { ArrowLeft, Check, Smartphone, Layers, Wifi, ArrowRight } from 'lucide-react';
---

<Layout title="Développement Mobile - AGWS" description="Applications iOS et Android natives et cross-platform haute performance.">
  <Navbar client:load />
  
  <main class="bg-agws-black min-h-screen pt-32">
    
    {/* HERO SECTION */}
    <section class="container mx-auto px-6 mb-24 text-center">
      <a href="/#services" class="inline-flex items-center gap-2 text-gray-500 hover:text-white transition-colors mb-8 font-mono text-xs uppercase tracking-widest">
        <ArrowLeft size={14} /> Retour aux services
      </a>
      
      <div class="inline-flex items-center gap-3 px-4 py-2 bg-white/5 border border-white mb-8 mx-auto">
        <Smartphone size={16} className="text-white" />
        <span class="text-xs font-mono tracking-widest text-white uppercase">Module Mobile_V1.0</span>
      </div>

      <h1 class="text-4xl md:text-6xl font-bold font-mono mb-6 text-white">
        DÉVELOPPEMENT MOBILE <br/>
        <span class="text-gray-500">& EXPÉRIENCE UTILISATEUR</span>
      </h1>
      
      <p class="text-gray-400 max-w-2xl mx-auto text-lg leading-relaxed mb-12">
        Vos utilisateurs sont mobiles. Nous créons des applications intuitives, rapides et addictives qui s'intègrent parfaitement à leur quotidien. iOS et Android.
      </p>
    </section>

    {/* OFFRE V1 - NATIVE / HYBRID */}
    <section class="py-24 border-t border-white/10 relative overflow-hidden">
      <div class="absolute inset-0 bg-white/5 skew-y-3 transform origin-top-right scale-110 z-0 pointer-events-none"></div>
      
      <div class="container mx-auto px-6 relative z-10 grid md:grid-cols-2 gap-12 items-center">
        <div class="order-2 md:order-1">
          <div class="inline-flex items-center gap-2 px-3 py-1 border border-white/20 text-xs font-mono mb-6 bg-black text-white">
            <span class="w-2 h-2 bg-white rounded-full"></span>
            OPTION_01
          </div>
          <h2 class="text-5xl font-bold font-mono mb-2 text-white">HYBRIDE & NATIVE</h2>
          <h3 class="text-2xl font-mono text-gray-400 mb-8">IOS & ANDROID</h3>
          
          <p class="text-gray-400 text-lg leading-relaxed mb-8">
            La solution idéale pour conquérir les Stores. 
            Une seule base de code performante (React Native / Flutter) déployée sur tous les écrans.
          </p>

          <ul class="space-y-4 mb-10 text-sm font-mono text-gray-300">
            <li class="flex gap-4 items-center"><Check size={18} className="text-white" /> Déploiement Apple & Google Stores</li>
            <li class="flex gap-4 items-center"><Check size={18} className="text-white" /> Accès Caméra, GPS, Notifications</li>
            <li class="flex gap-4 items-center"><Check size={18} className="text-white" /> Performance 60 FPS fluide</li>
            <li class="flex gap-4 items-center"><Check size={18} className="text-white" /> Mode Hors-ligne</li>
          </ul>

          <a href="#contact" class="inline-block px-8 py-4 bg-white text-black font-bold font-mono text-sm uppercase hover:bg-gray-200 transition-colors tracking-widest">
            LANCER UNE APP MOBILE
          </a>
        </div>

        <div class="order-1 md:order-2 flex justify-center relative">
           <div class="relative w-full max-w-md aspect-square bg-agws-black border border-white/10 p-8 flex items-center justify-center group hover:border-white transition-colors">
            <Smartphone size={128} strokeWidth={0.5} className="text-white opacity-80 group-hover:scale-110 transition-transform duration-500" />
            <div class="absolute -bottom-6 -right-6 font-mono text-[8rem] md:text-[10rem] font-bold text-white/5 select-none pointer-events-none">
              APP
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* OFFRE V2 - PWA */}
    <section class="py-24 border-t border-white/10 bg-agws-black relative">
      <div class="container mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
        
        <div class="flex justify-center relative">
           <div class="relative w-full max-w-md aspect-square bg-white/5 border border-white/10 p-8 flex items-center justify-center group">
            <Layers size={128} strokeWidth={0.5} className="text-white opacity-80 group-hover:rotate-180 transition-transform duration-1000" />
            <div class="absolute -bottom-6 -left-6 font-mono text-[8rem] md:text-[10rem] font-bold text-white/5 select-none pointer-events-none">
              WEB
            </div>
          </div>
        </div>

        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-white text-black text-xs font-mono mb-6 font-bold">
            <span class="w-2 h-2 bg-black rounded-full animate-pulse"></span>
            OPTION_02
          </div>
          <h2 class="text-5xl font-bold font-mono mb-2 text-white">PWA</h2>
          <h3 class="text-2xl font-mono text-gray-400 mb-8">PROGRESSIVE WEB APP</h3>
          
          <p class="text-gray-400 text-lg leading-relaxed mb-8">
            L'alternative légère. Une application web qui s'installe comme une app native, 
            sans passer par les stores. Idéal pour les outils internes, les MVP ou les services rapides.
          </p>

          <ul class="space-y-4 mb-10 text-sm font-mono text-gray-300">
            <li class="flex gap-4 items-center"><Check size={18} className="text-white" /> Accessible via URL instantanément</li>
            <li class="flex gap-4 items-center"><Check size={18} className="text-white" /> Pas de commissions Apple/Google (30%)</li>
            <li class="flex gap-4 items-center"><Check size={18} className="text-white" /> Mises à jour immédiates</li>
            <li class="flex gap-4 items-center"><Check size={18} className="text-white" /> Compatible Mobile, Tablette & Desktop</li>
          </ul>

          <a href="#contact" class="inline-block px-8 py-4 bg-transparent text-white font-bold font-mono text-sm uppercase hover:bg-white hover:text-black transition-colors tracking-widest border border-white">
            DÉMARRER UNE PWA
          </a>
        </div>

      </div>
    </section>

    <Contact client:visible />
  </main>
  
  <Footer />
</Layout>

