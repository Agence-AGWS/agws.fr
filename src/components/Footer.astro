---
const currentYear = new Date().getFullYear();
import { Linkedin, Github, Twitter, Mail } from 'lucide-react';
---

<footer class="border-t border-white/10 bg-agws-black py-12 relative overflow-hidden">
  
  <div class="container mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-12">
      
      {/* LEFT: Logo & Contact */}
      <div class="flex flex-col gap-4">
        <div class="h-12 w-auto flex items-center">
            <img src="/image.png" alt="AGWS Logo" class="h-full w-auto object-contain opacity-80 grayscale hover:opacity-100 hover:grayscale-0 transition-all" />
        </div>
        <a href="mailto:contact@agws.fr" class="flex items-center gap-2 text-xs font-mono text-gray-500 hover:text-white transition-colors">
          <Mail size={12} />
          contact@agws.fr
        </a>
      </div>
      
      {/* CENTER: Navigation */}
      <div class="flex flex-wrap justify-center gap-x-8 gap-y-4 text-xs font-mono font-bold tracking-widest text-gray-400">
        <a href="/#services" class="hover:text-white transition-colors">SERVICES</a>
        <a href="/services/web" class="hover:text-white transition-colors">WEB</a>
        <a href="/services/mobile" class="hover:text-white transition-colors">MOBILE</a>
        <a href="/services/ai" class="hover:text-white transition-colors">IA & DATA</a>
        <a href="/services/cloud" class="hover:text-white transition-colors">CLOUD</a>
      </div>

      {/* RIGHT: Copyright & Location */}
      <div class="flex flex-col items-start md:items-end gap-2 text-xs font-mono text-gray-500">
        <div class="flex items-center gap-4 mb-2">
            <a href="#" class="hover:text-white transition-colors"><Linkedin size={16} /></a>
            <a href="#" class="hover:text-white transition-colors"><Github size={16} /></a>
            <a href="#" class="hover:text-white transition-colors"><Twitter size={16} /></a>
        </div>
        <p>&copy; {currentYear} AGWS.</p>
        <p>Basé en Région Parisienne.</p>
        <div class="flex gap-4 mt-2 opacity-50 text-[10px]">
            <a href="/mentions-legales" class="hover:text-white">Mentions Légales</a>
        </div>
      </div>

    </div>
  </div>
</footer>
